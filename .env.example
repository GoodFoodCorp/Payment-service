PORT=8086
ENV=development
LOG_LEVEL=info
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=payment_db
DATABASE_URL=postgres://payment_user:YOUR_PASSWORD@localhost:5436/payment_db?sslmode=disable
JWT_SECRET=YOUR_SECRET_KEY_HERE
JWT_ISSUER=goodfood-auth
JWT_AUDIENCE=goodfood-api
# Shared secret of the /internal routes (order-service)
SERVICE_API_KEY=YOUR_SERVICE_KEY
# stripe | fake (fake approves every payment and is refused when ENV=production)
PAYMENT_GATEWAY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
